# Afhankelijkheden
node_modules/

# Env-bestanden met lokale/geheime instellingen (overal, ook in submappen)
.env
.env.*
!.env.example

# Vercel CLI (lokale koppeling met het project)
.vercel

# Database (SQLite, lokaal bestand)
backend/prisma/dev.db
backend/prisma/dev.db-journal

# Build-output
frontend/dist/
frontend/dist-ssr/

# Screenshots (Puppeteer-testtool)
frontend/temporary screenshots/

# Editor/OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db

# Losse bron-/referentiebestanden in de hoofdmap (aangeleverde ontwerp- en
# databestanden tijdens development — al gekopieerd naar frontend/backend
# waar nodig, horen niet in de repo zelf).
/*.png
/*.mp4
/*.zip
/*.json
# ...behalve de projectbestanden in de hoofdmap die er wél bij horen
!/vercel.json
!/package.json
/*.html
/*.jsx
/*.css
/*.routes.js

# Aangeleverde bronmappen en losse kopieën in de hoofdmap: wat de app nodig
# heeft staat al in frontend/public of frontend/src/data
/home/
/fan/
/plattegrond/
/tegels/
/tegels-v2/
/temporary screenshots/
/*.js
/CLAUDE (*).md
